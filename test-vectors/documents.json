{
  "description": "Shared validation cases. Each case starts from a base document, applies 'patch', removes the keys in 'remove', and must be accepted or rejected with an issue at 'path' by both the Zod schemas and the Rust validator. An empty path means the document itself (for example, an unknown field).",
  "bases": {
    "exam": {
      "id": "pvb-exam-fuvest",
      "type": "exam",
      "slug": "fuvest",
      "officialName": "Vestibular Fuvest",
      "shortName": "Fuvest",
      "institution": "Universidade de São Paulo (USP)",
      "examFormat": "mixed",
      "hasStudyPlan": true,
      "states": ["SP"],
      "audience": "Quem terminou ou está terminando o ensino médio",
      "summary": "Vestibular da USP, em duas fases.",
      "officialSiteUrl": "https://www.fuvest.br/",
      "sourceName": "Fuvest — site oficial",
      "sourceUrl": "https://www.fuvest.br/",
      "checkedAt": "2026-11-11",
      "nature": "official"
    },
    "event": {
      "id": "pvb-event-fuvest-2027-phase-1",
      "type": "event",
      "examSlug": "fuvest",
      "editionYear": 2027,
      "key": "phase-1",
      "category": "exam-day",
      "label": "1ª fase",
      "status": "official",
      "startDate": "2027-11-21",
      "endDate": "2027-11-21",
      "gatesOpen": "12:00",
      "gatesClose": "13:00",
      "durationMinutes": 300,
      "sourceName": "Fuvest — site oficial",
      "sourceUrl": "https://www.fuvest.br/",
      "checkedAt": "2026-11-11",
      "nature": "official"
    }
  },
  "cases": [
    { "name": "valid exam", "base": "exam", "valid": true },
    { "name": "exam id does not match slug", "base": "exam", "patch": { "id": "pvb-exam-unicamp" }, "valid": false, "path": "id" },
    { "name": "exam site outside the allowlist", "base": "exam", "patch": { "officialSiteUrl": "https://fuvest.blog/" }, "valid": false, "path": "officialSiteUrl" },
    { "name": "exam with an unknown field", "base": "exam", "patch": { "price": 10 }, "valid": false, "path": "" },
    { "name": "exam with an unknown state", "base": "exam", "patch": { "states": ["XX"] }, "valid": false, "path": "states.0" },
    { "name": "exam with a blank name", "base": "exam", "patch": { "officialName": "   " }, "valid": false, "path": "officialName" },
    { "name": "exam slug with upper case", "base": "exam", "patch": { "slug": "Fuvest" }, "valid": false, "path": "slug" },
    { "name": "source over plain http", "base": "exam", "patch": { "sourceUrl": "http://www.fuvest.br/" }, "valid": false, "path": "sourceUrl" },
    { "name": "source on a look-alike domain", "base": "exam", "patch": { "sourceUrl": "https://fuvest.br.site-falso.com/" }, "valid": false, "path": "sourceUrl" },
    { "name": "unknown nature", "base": "exam", "patch": { "nature": "opinion" }, "valid": false, "path": "nature" },
    { "name": "unknown document type", "base": "exam", "patch": { "type": "school" }, "valid": false, "path": "type" },
    { "name": "valid official event", "base": "event", "valid": true },
    { "name": "event not announced, without dates", "base": "event", "patch": { "status": "not-announced" }, "remove": ["startDate", "endDate", "gatesOpen", "gatesClose", "durationMinutes"], "valid": true },
    { "name": "event not announced, with a date", "base": "event", "patch": { "status": "not-announced" }, "valid": false, "path": "startDate" },
    { "name": "official event without a start date", "base": "event", "remove": ["startDate"], "valid": false, "path": "startDate" },
    { "name": "end date before start date", "base": "event", "patch": { "endDate": "2027-11-20" }, "valid": false, "path": "endDate" },
    { "name": "gates close before they open", "base": "event", "patch": { "gatesOpen": "13:00", "gatesClose": "12:30" }, "valid": false, "path": "gatesClose" },
    { "name": "impossible calendar date", "base": "event", "patch": { "startDate": "2027-02-30" }, "valid": false, "path": "startDate" },
    { "name": "impossible time", "base": "event", "patch": { "gatesOpen": "24:00" }, "valid": false, "path": "gatesOpen" },
    { "name": "event id does not match", "base": "event", "patch": { "id": "pvb-event-fuvest-2026-phase-1" }, "valid": false, "path": "id" },
    { "name": "unknown event category", "base": "event", "patch": { "category": "party" }, "valid": false, "path": "category" },
    { "name": "edition year out of range", "base": "event", "patch": { "editionYear": 1999 }, "valid": false, "path": "editionYear" },
    { "name": "zero duration", "base": "event", "patch": { "durationMinutes": 0 }, "valid": false, "path": "durationMinutes" },
    { "name": "event without a label", "base": "event", "remove": ["label"], "valid": false, "path": "label" }
  ]
}
